<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/ww_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:letterSpacing="0.08" android:textAllCaps="true" android:textColor="#FF9AA5AE" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="#FF9AA5AE" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_row0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:id="@+id/ww_stripe0" android:layout_width="4dp" android:layout_height="32dp"
                android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_stripe" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/ww_event0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FFE8E4DA" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/ww_detail0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FF9AA5AE" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:id="@+id/ww_stripe1" android:layout_width="4dp" android:layout_height="32dp"
                android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_stripe" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/ww_event1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FFE8E4DA" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/ww_detail1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FF9AA5AE" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/ww_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <ImageView android:id="@+id/ww_stripe2" android:layout_width="4dp" android:layout_height="32dp"
                android:contentDescription="@null" android:scaleType="fitXY" android:src="@drawable/widget_stripe" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/ww_event2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FFE8E4DA" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/ww_detail2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FF9AA5AE" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/ww_more" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="#FF9AA5AE" android:textSize="11sp" android:visibility="gone" />
        <LinearLayout android:id="@+id/ww_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="vertical">
            <TextView android:id="@+id/ww_empty_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:textColor="#FFE8E4DA" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/ww_empty_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="2" android:textColor="#FF9AA5AE" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
