<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wr_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_background" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/wr_summary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="1" android:textColor="#FFE8E4DA" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/wr_place" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:ellipsize="end" android:maxLines="1" android:textColor="#FF9AA5AE" android:textSize="12sp" />
        </LinearLayout>
        <ImageView android:id="@+id/wr_bars" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="8dp" android:minHeight="20dp" android:contentDescription="@null" android:scaleType="fitXY"
            android:src="@drawable/widget_rain_empty" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/wr_now" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="#FF9AA5AE" android:textSize="10sp" />
            <TextView android:id="@+id/wr_mid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_horizontal" android:textColor="#FF9AA5AE" android:textSize="10sp" />
            <TextView android:id="@+id/wr_end" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="end" android:textColor="#FF9AA5AE" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
